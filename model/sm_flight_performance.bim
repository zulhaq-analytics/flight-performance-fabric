      {
        "name": "_Measures",
        "lineageTag": "41412c8c-2e98-41c1-8331-105a45ed249a",
        "sourceLineageTag": "[dbo].[measure_table]",
        "columns": [
          {
            "name": "measure_home",
            "dataType": "int64",
            "sourceColumn": "measure_home",
            "formatString": "0",
            "lineageTag": "f9d1e8b1-9cef-4b0f-b9e8-c94b8fd85107",
            "sourceLineageTag": "measure_home",
            "summarizeBy": "none",
