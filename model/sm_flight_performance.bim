        ],
        "partitions": [
          {
            "name": "measure_table",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "measure_table",
              "expressionSource": "DirectLake - lh_gold",
              "schemaName": "dbo"
            }
          }
        ],
        "measures": [
          {
            "name": "Diverted Flights",
            "expression": "SUM(fact_flights[diverted_flag])",
            "formatString": "#,0",
            "displayFolder": "Volume",
            "lineageTag": "0b60bfcc-55ce-40b0-af15-b6e3885fa8d5"
          },
          {
            "name": "Cancelled Flights",
            "expression": "SUM(fact_flights[cancelled_flag])",
            "formatString": "#,0",
            "displayFolder": "Volume",
            "lineageTag": "e2b9e511-bcae-4457-a60d-be0d40ad457b"
          },
          {
            "name": "Operated Flights",
            "expression": "SUM(fact_flights[operated_flag])",
            "formatString": "#,0",
            "displayFolder": "Volume",
            "lineageTag": "71a3c507-dfe3-41f4-9d81-3132547d52d4"
          },
          {
            "name": "Scheduled Flights",
            "expression": "SUM(fact_flights[scheduled_flag])",
            "formatString": "#,0",
            "displayFolder": "Volume",
            "lineageTag": "68de79db-a548-40ea-8ff2-9fbf1f3e9a41"
          },
          {
            "name": "Delay-Eligible Flights",
            "expression": "SUM(fact_flights[delay_eligible_flag])",
            "formatString": "#,0",
            "displayFolder": "Reliability",
            "lineageTag": "072eed27-0eab-499c-98a0-5144a966acaa"
          },
          {
            "name": "Delayed Flights",
            "expression": "SUM(fact_flights[arrival_delayed_15_flag])",
            "formatString": "#,0",
            "displayFolder": "Reliability",
            "lineageTag": "e959987e-4a00-4246-9848-1ff8e8aaefcd"
          },
          {
            "name": "On-Time Flights",
            "expression": "SUM(fact_flights[on_time_arrival_flag])",
            "formatString": "#,0",
            "displayFolder": "Reliability",
            "lineageTag": "fa897e6e-e6a8-4d67-89e8-50cc8192d5a0"
          },
          {
            "name": "On-Time %",
            "expression": "DIVIDE([On-Time Flights], [Delay-Eligible Flights])",
            "formatString": "#,0.0%",
            "displayFolder": "Reliability",
            "lineageTag": "7f2e7720-afd7-495f-bc07-1d13a8437053"
          },
          {
            "name": "Delayed %",
            "expression": "DIVIDE([Delayed Flights], [Delay-Eligible Flights])",
            "formatString": "#,0.0%",
            "displayFolder": "Reliability",
            "lineageTag": "97fa0b3e-c7f6-4263-bc12-547b6f9588e5"
          },
          {
            "name": "Cancellation %",
            "expression": "DIVIDE([Cancelled Flights], [Scheduled Flights])",
            "formatString": "#,0.0%",
            "displayFolder": "Volume",
            "lineageTag": "c2c9dc5a-5305-4d7f-ae1c-765c22cd25c3"
          },
          {
            "name": "Diversion %",
            "expression": "DIVIDE([Diverted Flights], [Scheduled Flights])",
            "formatString": "#,0.0%",
            "displayFolder": "Volume",
            "lineageTag": "ceb8f673-24dc-468f-9423-22fb3e193144"
          },
          {
            "name": "Avg Departure Delay",
            "expression": "DIVIDE(SUM(fact_flights[departure_delay_min]), SUM(fact_flights[operated_flag]) + SUM(fact_flights[diverted_flag]))",
            "formatString": "#,0.0",
            "displayFolder": "Delay Magnitude",
            "lineageTag": "fe5a6a02-c5fe-4954-a6e7-31512f878460"
          },
          {
            "name": "Avg Arrival Delay",
            "expression": "DIVIDE(SUM(fact_flights[arrival_delay_min]), [Delay-Eligible Flights])",
            "formatString": "#,0.0",
            "displayFolder": "Delay Magnitude",
            "lineageTag": "928e692b-f0e9-4403-a637-855fda62ded2"
          },
          {
            "name": "Avg Delay When Late",
            "expression": "DIVIDE([Total Arrival Delay Minutes], [Delayed Flights])",
            "formatString": "#,0.0",
            "displayFolder": "Delay Magnitude",
            "lineageTag": "8f62cddc-367b-4ab8-b6ea-dcbae45db6fa"
          },
          {
            "name": "Total Arrival Delay Minutes",
            "expression": "SUM(fact_flights[arrival_delay_nonneg_min])",
            "formatString": "#,0",
            "displayFolder": "Delay Magnitude",
            "lineageTag": "6e434ce8-0d86-4094-be74-433d7e18261f"
          },
          {
            "name": "Carrier Delay Minutes",
            "expression": "SUM(fact_flights[carrier_delay_min])",
            "formatString": "#,0",
            "displayFolder": "Delay Causes",
            "lineageTag": "4e9a391b-c153-47ab-8101-ca04a14acf28"
          },
          {
            "name": "Weather Delay Minutes",
            "expression": "SUM(fact_flights[weather_delay_min])",
            "formatString": "#,0",
            "displayFolder": "Delay Causes",
            "lineageTag": "12bdae6f-2568-4efd-a423-c6714c12c9ee"
          },
          {
            "name": "NAS Delay Minutes",
            "expression": "SUM(fact_flights[nas_delay_min])",
            "formatString": "#,0",
            "displayFolder": "Delay Causes",
            "lineageTag": "3633f36b-f4ad-4e92-901d-5e8a7f88516e"
          },
          {
            "name": "Security Delay Minutes",
            "expression": "SUM(fact_flights[security_delay_min])",
            "formatString": "#,0",
            "displayFolder": "Delay Causes",
            "lineageTag": "e28b0579-d2a7-4e71-934b-b7c21431823d"
          },
          {
            "name": "Late Aircraft Delay Minutes",
            "expression": "SUM(fact_flights[late_aircraft_delay_min])",
            "formatString": "#,0",
            "displayFolder": "Delay Causes",
            "lineageTag": "3ac20789-e0c2-4fed-a69e-51139e03093e"
          },
          {
            "name": "Carrier Delay %",
            "expression": "DIVIDE([Carrier Delay Minutes], [Total Arrival Delay Minutes])",
            "formatString": "#,0.0%",
            "displayFolder": "Delay Causes",
            "lineageTag": "12a13603-abb1-4951-8ba4-1912970188fb"
          },
          {
            "name": "Weather Delay %",
            "expression": "DIVIDE([Weather Delay Minutes], [Total Arrival Delay Minutes])",
            "formatString": "#,0.0%",
            "displayFolder": "Delay Causes",
            "lineageTag": "ff1775ff-6459-4676-8b10-8a21f2fd285d"
          },
          {
            "name": "NAS Delay %",
            "expression": "DIVIDE([NAS Delay Minutes], [Total Arrival Delay Minutes])",
            "formatString": "#,0.0%",
            "displayFolder": "Delay Causes",
            "lineageTag": "b180e55d-debd-4634-8da8-2078a923300b"
          },
          {
            "name": "Security Delay %",
            "expression": "DIVIDE([Security Delay Minutes], [Total Arrival Delay Minutes])",
            "formatString": "#,0.0%",
            "displayFolder": "Delay Causes",
            "lineageTag": "93531f2f-69cc-4ddf-a536-017b29b16897"
          },
          {
            "name": "Late Aircraft Delay %",
            "expression": "DIVIDE([Late Aircraft Delay Minutes], [Total Arrival Delay Minutes])",
            "formatString": "#,0.0%",
            "displayFolder": "Delay Causes",
            "lineageTag": "35ed2034-1979-4673-83b2-24751a83d1cc"
          },
          {
            "name": "Avg Taxi Out",
            "expression": "AVERAGE(fact_flights[taxi_out_min])",
            "formatString": "#,0.0",
            "displayFolder": "Operations",
            "lineageTag": "b2c6b1f6-8a04-4f93-96a7-06243964fc3c"
          },
          {
            "name": "Avg Taxi In",
            "expression": "AVERAGE(fact_flights[taxi_in_min])",
            "formatString": "#,0.0",
            "displayFolder": "Operations",
            "lineageTag": "dc246b9c-4d6e-4098-93bc-b54205a48c11"
          },
          {
            "name": "Avg Air Time",
            "expression": "AVERAGE(fact_flights[air_time_min])",
            "formatString": "#,0.0",
            "displayFolder": "Operations",
            "lineageTag": "23aa80eb-c9c3-474c-bf2f-1d0191e6113f"
          },
          {
            "name": "Avg Route Distance",
            "expression": "AVERAGE(fact_flights[distance_miles])",
            "formatString": "#,0.0",
            "displayFolder": "Operations",
            "lineageTag": "a1777e92-2e95-4bf9-b8ff-e8e21b6a6292"
          },
          {
            "name": "Schedule Padding",
            "expression": "DIVIDE(SUM(fact_flights[scheduled_elapsed_min]) - SUM(fact_flights[actual_elapsed_min]), [Delay-Eligible Flights])",
            "formatString": "#,0.0",
            "displayFolder": "Operations",
            "lineageTag": "ec7e4016-5f7e-4cf3-a933-01a3a589bb4a"
          },
          {
            "name": "Operated Flights (Like-for-Like)",
            "expression": "CALCULATE([Operated Flights], KEEPFILTERS(dim_airline[reports_full_period] = TRUE()))",
            "formatString": "#,0",
            "displayFolder": "Like-for-Like",
            "lineageTag": "ce87b8c3-c153-4a05-aeb2-2393428d1ac0"
          },
          {
            "name": "On-Time % (Like-for-Like)",
            "expression": "CALCULATE([On-Time %], KEEPFILTERS(dim_airline[reports_full_period] = TRUE()))",
            "formatString": "#,0.0%",
            "displayFolder": "Like-for-Like",
            "lineageTag": "0059480b-fd60-453c-80bc-a30bb85b7b9d"
          },
          {
            "name": "Cancellation % (Like-for-Like)",
            "expression": "CALCULATE([Cancellation %], KEEPFILTERS(dim_airline[reports_full_period] = TRUE()))",
            "formatString": "#,0.0%",
            "displayFolder": "Like-for-Like",
            "lineageTag": "4318928d-bb1e-4a3f-896b-cace417d91bb"
          },
          {
            "name": "Operated Flights PY",
            "expression": "CALCULATE([Operated Flights], SAMEPERIODLASTYEAR(dim_date[date]))",
            "formatString": "#,0",
            "displayFolder": "Time Comparisons",
            "lineageTag": "f45f8185-2595-408b-8e16-b94f4967f436"
          },
          {
            "name": "On-Time % PY",
            "expression": "CALCULATE([On-Time %], SAMEPERIODLASTYEAR(dim_date[date]))",
            "formatString": "#,0.0%",
            "displayFolder": "Time Comparisons",
            "lineageTag": "62080bae-6a16-4b9d-8fed-96492bf6abff"
          },
          {
            "name": "Operated Flights YoY %",
            "expression": "DIVIDE([Operated Flights] - [Operated Flights PY], [Operated Flights PY])",
            "formatString": "+#,0.0%;-#,0.0%;#,0.0%",
            "displayFolder": "Time Comparisons",
            "lineageTag": "a6412f48-5866-4d73-87a3-d453c0d0f10e"
          },
          {
            "name": "On-Time % YoY pts",
            "expression": "( [On-Time %] - [On-Time % PY] ) * 100",
            "formatString": "+0.0;-0.0;0.0",
            "displayFolder": "Time Comparisons",
            "lineageTag": "5ea0101e-4ac1-47e3-ab50-a0fd55149d06"
          },
          {
            "name": "Operated Flights 2019",
            "expression": [
              "VAR PeriodsWithData = SUMMARIZE ( fact_flights, dim_date[month], dim_date[day_of_month] )",
              "RETURN",
              "CALCULATE (",
              "    [Operated Flights],",
              "    REMOVEFILTERS ( dim_date ),",
              "    dim_date[year] = 2019,",
              "    PeriodsWithData",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "vs 2019 Baseline",
            "lineageTag": "bec520e1-f284-4880-bdb1-61bece4f29cb"
          },
          {
            "name": "On-Time % 2019",
            "expression": [
              "VAR PeriodsWithData = SUMMARIZE ( fact_flights, dim_date[month], dim_date[day_of_month] )",
              "RETURN",
              "CALCULATE (",
              "    [On-Time %],",
              "    REMOVEFILTERS ( dim_date ),",
              "    dim_date[year] = 2019,",
              "    PeriodsWithData",
              ")"
            ],
            "formatString": "#,0.0%",
            "displayFolder": "vs 2019 Baseline",
            "lineageTag": "c047e5bf-81e0-425d-bd48-976498ad3938"
          },
          {
            "name": "Recovery vs 2019 %",
            "expression": [
              "IF (",
              "    HASONEVALUE ( dim_date[year] ),",
              "    DIVIDE ( [Operated Flights] - [Operated Flights 2019], [Operated Flights 2019] )",
              ")"
            ],
            "formatString": "+#,0.0%;-#,0.0%;#,0.0%",
            "displayFolder": "vs 2019 Baseline",
            "lineageTag": "f9fa4ff1-e3ed-489e-b3d1-46092bb894a5"
          },
          {
            "name": "On-Time vs 2019 pts",
            "expression": [
              "IF (",
              "    HASONEVALUE ( dim_date[year] ),",
              "    ( [On-Time %] - [On-Time % 2019] ) * 100",
              ")"
            ],
            "formatString": "+0.0;-0.0;0.0",
            "displayFolder": "vs 2019 Baseline",
            "lineageTag": "1ffa4f2c-86a2-430b-aa80-cc2b30e8cf79"
          },
          {
            "name": "Flights by Destination",
            "expression": "CALCULATE([Operated Flights], USERELATIONSHIP(fact_flights[dest_airport_key], dim_airport[airport_key]))",
            "formatString": "#,0",
            "displayFolder": "Airport Roles",
            "lineageTag": "e8fe47dd-633e-4652-8890-0f550ff66cf3"
          },
          {
            "name": "On-Time % by Destination",
            "expression": "CALCULATE([On-Time %], USERELATIONSHIP(fact_flights[dest_airport_key], dim_airport[airport_key]))",
            "formatString": "#,0.0%",
            "displayFolder": "Airport Roles",
            "lineageTag": "ac69aa8d-bb9e-4e0f-9cfb-7e722a529a58"
          },
          {
            "name": "Narrative Overview",
            "expression": [
              "VAR Yr = SELECTEDVALUE ( dim_date[year] )",
              "VAR Flights = [Operated Flights]",
              "VAR OnTime = [On-Time %]",
              "VAR Gap2019 = [On-Time vs 2019 pts]",
              "VAR VolGap2019 = [Recovery vs 2019 %]",
              "VAR VolYoY = [Operated Flights YoY %]",
              "VAR OnTimeYoY = [On-Time % YoY pts]",
              "RETURN",
              "IF (",
              "    ISBLANK ( Flights ),",
              "    \"No flights match the current selection.\",",
              "    \"In \" & Yr & \", airlines operated \" & FORMAT ( Flights, \"#,0\" ) & \" flights - \"",
              "        & FORMAT ( ABS ( VolGap2019 ), \"0.0%\" ) & IF ( VolGap2019 >= 0, \" above\", \" below\" ) & \" 2019 and \"",
              "        & FORMAT ( ABS ( VolYoY ), \"0.0%\" ) & IF ( VolYoY >= 0, \" up\", \" down\" ) & \" on the prior year. \"",
              "        & FORMAT ( OnTime, \"0.0%\" ) & \" arrived on time: \"",
              "        & FORMAT ( ABS ( Gap2019 ), \"0.0\" ) & \" points \" & IF ( Gap2019 >= 0, \"better\", \"worse\" ) & \" than 2019, \"",
              "        & FORMAT ( ABS ( OnTimeYoY ), \"0.0\" ) & \" points \" & IF ( OnTimeYoY >= 0, \"better\", \"worse\" ) & \" than \" & Yr - 1 & \".\"",
              ")"
            ],
            "displayFolder": "Narratives",
            "lineageTag": "bbd20e18-21d6-49f9-a7bc-912a0f2585ac"
          },
          {
            "name": "Narrative Recovery",
            "expression": [
              "VAR Yr = SELECTEDVALUE ( dim_date[year] )",
              "VAR TotalFlights = [Operated Flights]",
              "VAR LFL = [Operated Flights (Like-for-Like)]",
              "VAR VolGap = [Recovery vs 2019 %]",
              "VAR Share = DIVIDE ( LFL, TotalFlights )",
              "RETURN",
              "IF (",
              "    ISBLANK ( TotalFlights ),",
              "    \"No flights match the current selection.\",",
              "    \"Across all carriers, \" & Yr & \" volume was \" & FORMAT ( ABS ( VolGap ), \"0.0%\" )",
              "        & IF ( VolGap >= 0, \" above\", \" below\" ) & \" 2019. The 12 airlines reporting in every month flew \"",
              "        & FORMAT ( LFL, \"#,0\" ) & \" of those flights (\" & FORMAT ( Share, \"0.0%\" ) & \" of the total).\"",
              ")"
            ],
            "displayFolder": "Narratives",
            "lineageTag": "7232b101-8c67-4dac-8797-086e9e8973b8"
          },
          {
            "name": "Narrative Reliability",
            "expression": [
              "VAR Yr = SELECTEDVALUE ( dim_date[year] )",
              "VAR OnTime = [On-Time %]",
              "VAR Gap = [On-Time vs 2019 pts]",
              "VAR WhenLate = [Avg Delay When Late]",
              "VAR TopCause =",
              "    VAR Causes =",
              "        DATATABLE ( \"Cause\", STRING, \"Rank\", INTEGER, { { \"late-arriving aircraft\", 1 }, { \"carrier operations\", 2 }, { \"the air traffic system\", 3 }, { \"weather\", 4 } } )",
              "    VAR LateA = [Late Aircraft Delay %]",
              "    VAR Carrier = [Carrier Delay %]",
              "    VAR Nas = [NAS Delay %]",
              "    VAR Weather = [Weather Delay %]",
              "    VAR MaxShare = MAX ( MAX ( LateA, Carrier ), MAX ( Nas, Weather ) )",
              "    RETURN",
              "        SWITCH (",
              "            MaxShare,",
              "            LateA, \"late-arriving aircraft\",",
              "            Carrier, \"carrier operations\",",
              "            Nas, \"the air traffic system\",",
              "            Weather, \"weather\"",
              "        )",
              "RETURN",
              "IF (",
              "    ISBLANK ( OnTime ),",
              "    \"No flights match the current selection.\",",
              "    FORMAT ( OnTime, \"0.0%\" ) & \" of \" & Yr & \" flights arrived on time, \"",
              "        & FORMAT ( ABS ( Gap ), \"0.0\" ) & \" points \" & IF ( Gap >= 0, \"better\", \"worse\" )",
              "        & \" than 2019. Late flights ran \" & FORMAT ( WhenLate, \"0\" )",
              "        & \" minutes behind on average, most often because of \" & TopCause & \".\"",
              ")"
            ],
            "displayFolder": "Narratives",
            "lineageTag": "c41792b3-70ad-4ab4-9619-9e9992281ce6"
          },
          {
            "name": "Narrative Airports",
            "expression": [
              "VAR Yr = SELECTEDVALUE ( dim_date[year] )",
              "VAR Flights = [Operated Flights]",
              "VAR Airports = CALCULATE ( DISTINCTCOUNT ( fact_flights[origin_airport_key] ) )",
              "VAR Taxi = [Avg Taxi Out]",
              "RETURN",
              "IF (",
              "    ISBLANK ( Flights ),",
              "    \"No flights match the current selection.\",",
              "    \"Departures in \" & Yr & \" covered \" & FORMAT ( Airports, \"#,0\" ) & \" airports. \"",
              "        & \"Aircraft spent \" & FORMAT ( Taxi, \"0.0\" ) & \" minutes taxiing out on average before takeoff.\"",
              ")"
            ],
            "displayFolder": "Narratives",
            "lineageTag": "1c19569b-1c44-4057-b185-fcb3afe7a3c4"
          }
        ]
      }
    ],
